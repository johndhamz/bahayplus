# ---------------------------------------------------------------
# Bahay+ environment variables. Copy to .env.local for local dev.
# NEVER commit real values. NEVER prefix secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------

# Public (inlined into browser bundles)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54721
# Local: run `npm run db:status` and copy the "Publishable" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only
# Local: the "Secret" key from `npm run db:status`. Bypasses RLS — server use only.
SUPABASE_SECRET_KEY=
# Shared secret for /api/internal/jobs/* (min 32 chars). Generate: openssl rand -hex 32
JOB_RUNNER_SECRET=
# local | test | staging | production
APP_ENV=local

# Optional: serve /preview (sample-data design previews) in a production build. Default off.
ENABLE_DESIGN_PREVIEW=false
