{
  "name": "bahayplus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev -w @bahayplus/web",
    "build": "npm run build -w @bahayplus/web",
    "start": "npm run start -w @bahayplus/web",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typegen -w @bahayplus/web && tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit --project components",
    "test:watch": "vitest --project unit --project components",
    "test:integration": "vitest run --project integration --project security",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:start": "supabase start -x edge-runtime,studio,logflare,vector,imgproxy,supavisor,realtime,postgres-meta",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/types/src/database.ts && prettier --write --ignore-path /dev/null packages/types/src/database.ts",
    "db:lint": "supabase db lint --level warning",
    "test:e2e:smoke": "playwright test --grep @smoke --project=desktop --project=mobile-390",
    "test:perf": "playwright test -c playwright.perf.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules"
  ],
  "type": "module"
}
