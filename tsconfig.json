{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "paths": { "@/*": ["./apps/web/*"] }
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "modules/**/*.ts",
    "*.config.ts",
    "*.config.mts",
    "apps/web/next-env.d.ts",
    "apps/web/.next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules"]
}
